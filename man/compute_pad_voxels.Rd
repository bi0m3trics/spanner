las <- lidR::readTLSLAS(LASfile, select = "xyzcr",
                        "-filter_with_voxel 0.01")
sf::st_crs(las) <- 26912
las <- lidR::normalize_height(las, lidR::tin())

pad <- compute_pad_voxels(las, vox_size = 0.5)
